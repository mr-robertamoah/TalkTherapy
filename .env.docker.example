APP_NAME=TalkTherapy
APP_ENV=local
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_SCHEME=http
VITE_DEV_SERVER_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=talktherapy
DB_USERNAME=talktherapy
DB_PASSWORD=secret

BROADCAST_CONNECTION=reverb
# CACHE_STORE takes precedence over CACHE_DRIVER in config/cache.php (SCRUM-105) -- set it
# instead of/in addition to CACHE_DRIVER if you need to override the cache store here.
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# In Docker, mail is caught by Mailpit (http://localhost:8027) -- nothing is delivered.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"
# Deployed environments (testing, production): Mailgun instead of the Mailpit lines above.
# MAIL_HOST=smtp.eu.mailgun.org
# MAIL_PORT=587
# MAIL_USERNAME=postmaster@your-mailgun-domain.com
# MAIL_PASSWORD=your-mailgun-password
MAILGUN_DOMAIN=your-mailgun-domain.com
MAILGUN_SECRET=your-mailgun-secret-key

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=127.0.0.1
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

REVERB_APP_ID=my_app_id
REVERB_APP_KEY=my_app_key
REVERB_APP_SECRET=my_app_secret
# Server-to-server publishing target (php/queue containers -> reverb container) -- must be the
# Docker Compose service name, not localhost. localhost from inside php/queue resolves to that
# container itself, not the reverb container, so every broadcast would silently fail to connect
# ("cURL error 7: Failed to connect to localhost port 8081"). VITE_REVERB_HOST below stays
# "localhost" on purpose -- that's for the browser, which reaches Reverb via the host-mapped port.
REVERB_HOST=reverb
REVERB_PORT=8081
REVERB_SERVER_PORT=8081
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL=http://localhost:8000
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

VITE_COUNTRIES_API=https://countriesnow.space/api/v0.1

SUPER_PASSWORD=your-super-admin-password

GROUP_THERAPY_MAX_USERS=25
GROUP_THERAPY_MAX_COUNSELLORS=10
THERAPY_MAX_SESSIONS=100
# A discussion's max counsellors -- its own cap, separate from the group one (config/limits.php).
DISCUSSION_MAX_COUNSELLORS_CEILING=50

# Paystack test-mode keys -- get these from your Paystack dashboard's "Test" API keys page.
# Never put live keys in a non-production environment.
PAYSTACK_SECRET_KEY=sk_test_your-paystack-test-secret-key
PAYSTACK_PUBLIC_KEY=pk_test_your-paystack-test-public-key
PAYSTACK_BASE_URL=https://api.paystack.co
# SCRUM-272: seconds -- fail fast when Paystack is unreachable
PAYSTACK_CONNECT_TIMEOUT=5
PAYSTACK_TIMEOUT=15
# SCRUM-248: org charges pending longer than this are checked with Paystack; still unresolved after the
# alert period, they're logged for manual follow-up.
ORG_STALE_CHARGE_RECONCILE_AFTER_MINUTES=30
ORG_STALE_CHARGE_ALERT_AFTER_HOURS=24
# SCRUM-373: the scheduler's own cache store (once-only reminder keys, heartbeat) -- cache:clear leaves it.
SCHEDULER_CACHE_STORE=scheduler

VITE_GOOGLE_API_KEY="your-google-api-key"
CORS_ALLOWED_ORIGINS="http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173"
SANCTUM_STATEFUL_DOMAINS='localhost,localhost:8000,127.0.0.1,127.0.0.1:8000,::1'
DS_APP_HOST=127.0.0.1
DS_INSTALLED=false

# Counsellor accounts and verification documents (config/counsellor.php)
COUNSELLOR_DELETION_GRACE_PERIOD_DAYS=60
# SCRUM-367: days after an account is closed before its personal details are erased (config/user.php)
CLOSED_ACCOUNT_RETENTION_DAYS=30
# SCRUM-338: days after a decision before verification documents are deleted
COUNSELLOR_LICENSE_REJECTED_RETENTION_DAYS=30
COUNSELLOR_NATIONAL_ID_RETENTION_DAYS=30
COUNSELLOR_LICENSE_ABANDONED_RETENTION_DAYS=30

# SCRUM-39: days notifications are kept unless a person chooses otherwise (minimum 7; default 90).
NOTIFICATIONS_RETENTION_DAYS=90

# SCRUM-395: urgent help safeguards. HELP_ENABLED=false stops new requests (the dialog still shows the
# emergency numbers). New (<HELP_NEW_ACCOUNT_HOURS) accounts, or ones with an unverified email, may ask
# HELP_NEW_ACCOUNT_REQUESTS_PER_HOUR times an hour; at most HELP_RINGS_PER_MINUTE requests ring counsellors per
# minute, platform-wide, in each of two buckets (established accounts; new or unverified ones).
HELP_ENABLED=true
HELP_NEW_ACCOUNT_HOURS=24
HELP_NEW_ACCOUNT_REQUESTS_PER_HOUR=1
HELP_RINGS_PER_MINUTE=30

# SCRUM-395/400/138: behind a load balancer, reverse proxy or CDN, its own addresses or CIDR ranges, comma-separated
# (e.g. 10.0.0.0/16, or the CDN's published ranges). Only explicit ones count: "*", REMOTE_ADDR, PRIVATE_SUBNETS,
# anything wider than /8 (IPv4) or /29 (IPv6), IPv4-mapped IPv6 ranges and malformed entries are ignored, with a
# "TRUSTED_PROXIES entries ignored." warning logged. Empty: none trusted -- right when nginx is the first hop (FastCGI,
# as in Docker).
# REQUIRED before production goes live behind its proxy: without it every visitor shares the proxy's address
# (and so one sign-up limit and one urgent-help limit), and requests look like http.
TRUSTED_PROXIES=

# SCRUM-400: accounts that may be created from one network address in an hour (failed attempts don't count).
REGISTRATIONS_PER_HOUR_PER_ADDRESS=10

# SCRUM-397: once deployed the app answers only for APP_URL's host, plus these exact hostnames (comma-separated,
# bare hostnames). Not for a second public domain -- redirect that at the proxy. APP_URL must be the real public
# https URL: every absolute link is built on it. See documentation/operations/production-checklist.md.
TRUSTED_HOSTS=

# SCRUM-403: websocket origins Reverb accepts (comma-separated host patterns). Empty: anything for APP_ENV local
# and testing; otherwise APP_URL's host plus TRUSTED_HOSTS.
REVERB_ALLOWED_ORIGINS=

# SCRUM-399: web push for urgent help rings. Off until switched on; keys from `php artisan push:vapid-keys`, made once per
# environment and kept as secrets (changing them ends every device's subscription). Needs HTTPS (localhost is fine) and
# the queue worker running --queue=urgent,default.
HELP_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com
# Seconds a push service keeps an undelivered ring before dropping it.
HELP_PUSH_TTL=120
# The push services a device's address may be at (https only; "*." matches subdomains). Leave unset for the default.
# HELP_PUSH_ENDPOINT_HOSTS=fcm.googleapis.com,android.googleapis.com,*.push.services.mozilla.com,*.push.apple.com,*.notify.windows.com

# SCRUM-406: the browser history of Inertia pages is encrypted (and cleared on sign-out) so the back button
# after signing out cannot show chats or admin views. On unless set to false. Applied only to https requests or a
# localhost host, where the browser can encrypt -- behind a TLS-terminating proxy that needs TRUSTED_PROXIES.
INERTIA_ENCRYPT_HISTORY=true


# --- Settings documented in .env.example, kept in step here (SCRUM-413) ---

# Comma-separated list of currency codes accepted platform-wide (see config/currencies.php).
SUPPORTED_CURRENCIES=USD,GHS

# TT-3.1a/SCRUM-274: which VideoProviderInterface adapter is active for this deployment -- a
# deployment-level choice, not a live per-session runtime switch. 'daily' or 'chime'.
VIDEO_PROVIDER=daily
# Seconds of no speaking activity before a granted group-video speaker reverts to receive-only.
VIDEO_SPEAKING_GRANT_IDLE_TIMEOUT=300

# Daily.co test/dev API key -- get this from your Daily.co dashboard's Developers page.
DAILY_API_KEY=your-daily-api-key
DAILY_BASE_URL=https://api.daily.co/v1
DAILY_DOMAIN=your-daily-domain

# Amazon Chime SDK Meetings -- deliberately a Chime-scoped IAM principal (chime:CreateMeeting/
# CreateAttendee/DeleteMeeting only), not the same credentials as any other AWS integration
# (e.g. SES) this app uses. media_region is the meeting's own MediaPlacement region, independent
# of the region the SDK client itself authenticates against.
CHIME_AWS_ACCESS_KEY_ID=
CHIME_AWS_SECRET_ACCESS_KEY=
CHIME_AWS_REGION=us-east-1
CHIME_MEDIA_REGION=us-east-1

# SCRUM-31 (config/counsellor.php): how many months a counsellor verification lasts, and the reminder days before it ends
# (comma-separated; the largest is also when early re-verification opens). Optional.
COUNSELLOR_VERIFICATION_VALIDITY_MONTHS=12
COUNSELLOR_VERIFICATION_REMINDER_DAYS=30,7
# SCRUM-392: offers to help (therapies + groups) a counsellor may send per rolling 24h. Optional.
COUNSELLOR_DAILY_OFFER_CAP=5
# SCRUM-33: the quick help chat (config/help.php). All optional.
HELP_DEFAULT_COUNTRY=GH
HELP_NUMBER_REVIEW_MONTHS=6
HELP_AVAILABILITY_HOURS=4
HELP_FIRST_ALERT_SECONDS=60
HELP_SECOND_ALERT_SECONDS=180
HELP_EXPIRE_AFTER_MINUTES=10
HELP_SESSION_MINUTES=60
HELP_TRANSCRIPT_RETENTION_DAYS=365
HELP_REQUESTS_PER_HOUR=3
HELP_SUSPENDED_REQUESTS_PER_HOUR=1
HELP_REQUESTS_PER_HOUR_PER_ADDRESS=10

# SCRUM-32: counsellors' safety flags (config/safety.php). Off until the Ghana Act 846/843 legal read.
SAFETY_FLAGS_ENABLED=false
SAFETY_FLAGS_PER_HOUR=10
SAFETY_FLAG_WINDOW_DAYS=14
SAFETY_REALERT_MINUTES_IMMINENT=60
SAFETY_REALERT_MINUTES_URGENT=240
SAFETY_REALERT_MINUTES_NON_URGENT=1440
# Must be set before SAFETY_FLAGS_ENABLED is switched on in production.
SAFETY_FALLBACK_MAILBOX=

# SCRUM-35: the password policy (defaults shown). PASSWORD_CHECK_BREACHES=false turns off the Have I Been Pwned check.
# PASSWORD_MIN_LENGTH=10
# PASSWORD_CHECK_BREACHES=true
# PASSWORD_BREACH_CHECK_TIMEOUT=3
# SCRUM-34: two-factor sign-in with an authenticator app. Keep it off until sign-in asks for the code (SCRUM-34b).
# TWO_FACTOR_ENABLED=false
